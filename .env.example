# Copiez en .env (jamais versionné). Vide = mode démo, sans clé.

# demo (défaut, rien de facturé) | live (appels réels Jev + Claude)
TRIAGE_MODE=

# Jev (iajev.com) — décision typée. Clé : tableau de bord iajev.com.
JEV_API_KEY=
JEV_CONFIDENCE_THRESHOLD=
# Prix d'un crédit en euros (défaut : offre Starter, 16,90 € / 15 000 crédits)
JEV_CREDIT_EUR=

# Claude (API Anthropic) — arbitrage, résumé, brouillon.
ANTHROPIC_API_KEY=
# claude-sonnet-5 (défaut) ou claude-opus-5-5 pour les cas lourds
CLAUDE_MODEL=
# low (défaut) | medium | high
CLAUDE_EFFORT=
# Taux de conversion pour l'estimation des coûts (défaut 0.86)
EUR_PER_USD=

# Alerte (urgent / à vérifier) : URL de webhook Slack, Teams, ntfy, n8n…
ALERT_WEBHOOK_URL=

# Base locale (changez-le hors démo)
POSTGRES_PASSWORD=

# Ports publiés sur 127.0.0.1
DASHBOARD_PORT=
N8N_PORT=
