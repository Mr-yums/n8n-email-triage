    {
      "id": "066f848b-61c3-5c58-aaf5-4b1f4878c513",
      "name": "Créer le dossier de tri",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        320
      ],
      "parameters": {
        "jsCode": "// Construit le « dossier de tri » { email } à partir d'un email d'exemple\n// ou d'un message lu par le nœud IMAP (format « resolved »).\nconst first = (v) => Array.isArray(v) ? v[0] : v;\nreturn $input.all().map((item) => {\n  const j = item.json;\n  if (j.message_id && j.from_address) return { json: { email: j } };\n  const from = first(j.from?.value) ?? {};\n  const headers = j.headers ?? {};\n  const unsubscribe = Boolean(headers['list-unsubscribe'] ?? headers['List-Unsubscribe']);\n  return { json: { email: {\n    message_id: j.messageId ?? j['message-id'] ?? headers['message-id'] ?? `${j.date}-${j.subject}`,\n    from_name: from.name ?? '',\n    from_address: (from.address ?? j.from?.text ?? String(j.from ?? '')).toLowerCase(),\n    subject: j.subject ?? '',\n    date: j.date ? new Date(j.date).toISOString() : null,\n    body: (j.text ?? j.textPlain ?? '').slice(0, 20000),\n    attachments: Object.values(item.binary ?? {}).map((b) => b.fileName).filter(Boolean),\n    list_unsubscribe: unsubscribe,\n  } } };\n});"
      }
    },
